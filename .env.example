# NEW STAR TAILOR — copy to .env and fill in. Never commit .env.

# ── Core ───────────────────────────────────────────────
FLASK_ENV=development
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# ── Database (MySQL / MariaDB) ─────────────────────────
# See docs/DATABASE_SETUP.md for the CREATE DATABASE / CREATE USER commands.
DATABASE_URL=mysql+pymysql://nst_user:nst_pass@127.0.0.1:3306/nst_dev?charset=utf8mb4
# Used only by the test suite (Phase 2+). Leave blank to use in-memory SQLite.
TEST_DATABASE_URL=

# ── Locale ────────────────────────────────────────────
DEFAULT_LOCALE=en
TIMEZONE=Asia/Kolkata

# ── Cookies / HTTPS ───────────────────────────────────
# Set to true in production (behind HTTPS).
SESSION_COOKIE_SECURE=false

# ── Uploads ───────────────────────────────────────────
MAX_UPLOAD_MB=8
# UPLOAD_DIR defaults to instance/uploads

# ── Rate limiting ─────────────────────────────────────
# memory:// for a single process; use redis://... for multi-worker prod.
RATELIMIT_STORAGE_URI=memory://

# ── Payment provider (connected later — do NOT invent credentials) ──
PAYMENT_PROVIDER=manual
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_SECRET=

# ── WhatsApp / messaging (connected later) ────────────
WHATSAPP_API_KEY=
WHATSAPP_PHONE_ID=
