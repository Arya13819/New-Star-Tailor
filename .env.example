# NEW STAR TAILOR — copy to .env and fill in. Never commit .env.

# ── Core ───────────────────────────────────────────────
FLASK_ENV=development
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# ── Database (MySQL / MariaDB) ─────────────────────────
# See docs/DATABASE_SETUP.md for the CREATE DATABASE / CREATE USER commands.
# Leave DATABASE_URL blank to use a local SQLite file (instance/nst_dev.sqlite)
# while MySQL is not yet provisioned. Set it once MariaDB is ready:
#   mysql+pymysql://nst_user:PASSWORD@127.0.0.1:3306/nst_dev?charset=utf8mb4
DATABASE_URL=
# Blank -> in-memory SQLite for the test suite. Point at nst_test on MySQL to
# run tests against the real engine:
#   mysql+pymysql://nst_user:PASSWORD@127.0.0.1:3306/nst_test?charset=utf8mb4
TEST_DATABASE_URL=

# ── Locale ────────────────────────────────────────────
DEFAULT_LOCALE=en
TIMEZONE=Asia/Kolkata

# ── Cookies / HTTPS ───────────────────────────────────
# Set to true in production (behind HTTPS).
SESSION_COOKIE_SECURE=false

# ── Uploads ───────────────────────────────────────────
MAX_UPLOAD_MB=8
# UPLOAD_DIR defaults to instance/uploads

# ── Rate limiting ─────────────────────────────────────
# memory:// for a single process; use redis://... for multi-worker prod.
RATELIMIT_STORAGE_URI=memory://

# ── Payment provider (connected later — do NOT invent credentials) ──
PAYMENT_PROVIDER=manual
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_SECRET=

# ── SMS messaging (connected later — plain SMS only, never WhatsApp) ──
SMS_API_KEY=
SMS_SENDER_ID=

# Optional local MySQL 8.4 container: docker compose up -d mysql
# Choose unique passwords. DATABASE_URL must use the same MYSQL_PASSWORD,
# URL-encoded when it contains special characters. Default exposed port: 3307.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3307
